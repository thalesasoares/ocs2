# Default environment variables for the OCS2 dev container.
# These are read automatically by `docker compose` from this file.
# Override on the host by setting the variable in your shell before running compose.

# ROS2 domain — isolates your DDS traffic from other ROS2 systems on the network.
ROS_DOMAIN_ID=0

# X11 display — :0 is the default local display; update if you use a different one.
DISPLAY=:0
